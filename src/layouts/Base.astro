---
interface Props {
  title?: string;
  description?: string;
}

const { title = "Kris Kemper", description = "Software engineer based in Atlanta, GA." } = Astro.props;
---

<html lang="en" data-theme="nordic">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.png" />
    <title>{title}</title>
    <style is:global>
      @import "../styles/global.css";
    </style>
    <style is:global>
      @import "../styles/themes.css";
    </style>
  </head>
  <body>
    <div class="wrapper">
      <nav>
        <ul>
          <li><a href="/">home</a></li>
          <li><a href="/about/">about</a></li>
          <li><a href="/projects/">projects</a></li>
        </ul>
      </nav>

      <slot />

      <footer>
        <a href="https://linkedin.com/in/kriskemper">linkedin</a>
        &nbsp;&middot;&nbsp;
        <a href="https://github.com/kemper">github</a>
      </footer>
    </div>

  </body>
</html>
